# false: local ports only, true: Caddy automatic HTTPS on ports 80/443
TECHPEDIA_ENABLE_HTTPS=false

# Public origin. Point this DNS name to the server.
TECHPEDIA_DOMAIN=wiki.example.com
TECHPEDIA_PUBLIC_URL=http://localhost:8080
TECHPEDIA_TLS_EMAIL=admin@example.com

# Keep report-only until the CSP rollout checklist has no violations.
TECHPEDIA_CSP_MODE=report-only

# Create an editable UI-message draft when an administrator accepts a language proposal.
# Only TechPedia's fixed English interface seeds are sent to the translation endpoint.
TECHPEDIA_INTERFACE_AUTO_TRANSLATION=false
TECHPEDIA_INTERFACE_TRANSLATION_URL=https://api.mymemory.translated.net/get
# Optional contact address accepted by the default public translation service.
TECHPEDIA_INTERFACE_TRANSLATION_EMAIL=

# Built-in privacy-preserving aggregate traffic statistics.
TECHPEDIA_ANALYTICS_ENABLED=true
# The reverse proxy must replace this header instead of accepting a client value.
TECHPEDIA_ANALYTICS_COUNTRY_HEADER=CF-IPCountry

# Optional admin OAuth MCP endpoint: read and reviewed proposals, never direct writes.
# Host and browser Origin must match TECHPEDIA_PUBLIC_URL exactly.
TECHPEDIA_MCP_ENABLED=false

# Optional server or data-center location shown only in the administrator panel.
TECHPEDIA_SERVER_LOCATION=

# Bound to loopback because Caddy is the public entry point.
TECHPEDIA_HTTP_BIND=127.0.0.1

# The username identifies the single immutable owner; keep it after initial setup.
# The password is required only when that account does not exist and never resets it.
TECHPEDIA_BOOTSTRAP_ADMIN_USERNAME=techpedia_admin
TECHPEDIA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Global media library. Defaults reserve about 100 MiB below a 1 GiB volume budget.
TECHPEDIA_MEDIA_STORAGE_LIMIT_BYTES=943718400
TECHPEDIA_MEDIA_UPLOAD_LIMIT_BYTES=10485760
